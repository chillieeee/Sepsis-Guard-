# =============================================================================
# SepsisGuard — .gitignore
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-log.txt
pip-delete-this-directory.txt

# --- Virtual environments ---
venv/
env/
.venv/
ENV/
.env/

# --- Environment & secrets ---
.env
*.env
.env.local
.env.*.local

# --- Large data files (tracked separately or via Git LFS) ---
# Raw dataset — too large for standard Git (54 MB)
Dataset.csv
# Per-patient summary — regenerated by prepare_data.py
patient_summary.csv

# --- Trained model binary ---
# Regenerated by train_model.py; use Git LFS or a release asset for distribution
# Uncomment the line below if you do NOT want to commit the model:
# sepsis_model.pkl

# --- IDE / editor ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb

# --- Testing & coverage ---
.pytest_cache/
.coverage
htmlcov/
.tox/
coverage.xml
*.cover

# --- Linting / type-checking caches ---
.mypy_cache/
.ruff_cache/
.flake8

# --- OS ---
Desktop.ini
ehthumbs.db

# --- Logs ---
*.log
logs/
