# SepsisGuard — Environment Configuration
# ----------------------------------------
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Set to 0 in production to disable debug mode and the interactive debugger.
FLASK_DEBUG=1

# TCP port the Flask development server listens on.
PORT=5000

# Path to the trained model file (relative to the project root).
MODEL_PATH=sepsis_model.pkl
